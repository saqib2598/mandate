# Stub is the default. Point this at a local Ollama only when you want a live model.
MANDATE_LLM_PROVIDER=stub
MANDATE_OLLAMA_BASE_URL=http://127.0.0.1:11460
MANDATE_MODEL=qwen3.8:27b
MANDATE_EMBED_MODEL=nomic-embed-text
# hashing | ollama | off. off is BM25 alone. ollama uses nomic-embed-text on the URL above.
MANDATE_EMBEDDINGS=hashing
# Do not use ports 11434 or 11440. The client refuses them.
# MANDATE_OPENAI_BASE_URL=http://127.0.0.1:11460/v1
# MANDATE_OPENAI_API_KEY=
